# Frontend env (copy to `.env` or `.env.local` for local dev; set on the host for deploys).
# All vars MUST start with VITE_ to be exposed to the bundled app.

# REST + SSE base URL — include the /api/v1 prefix.
VITE_API_BASE=http://localhost:8000/api/v1

# Backend root — used only by the top-level health probe (`GET /`).
VITE_BACKEND_ROOT=http://localhost:8000

# Discord webhook receiver (bot/bot.py listens here). Optional.
VITE_DISCORD_WEBHOOK_URL=http://localhost:5000/alert
